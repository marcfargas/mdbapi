# ci/Dockerfile.testenv
# Windows Server Core test environment with the Microsoft Access Database Engine
# (64-bit) pre-installed. Used for service-installer and ODBC integration tests.
#
# Built via .github/workflows/ci-images.yml and pushed to:
#   ghcr.io/marcfargas/mdbapi-testenv:latest
#
# Requires: docker build on a windows-latest runner (process isolation,
# host OS must match container OS -- both ltsc2022).

FROM mcr.microsoft.com/windows/servercore:ltsc2022

# Copy the ACE installer script and run it with -File (explicit file execution,
# avoids SHELL-directive concatenation quirks and encoding surprises).
COPY ci/install-ace.ps1 C:\\install-ace.ps1
RUN powershell -ExecutionPolicy Bypass -NoProfile -NonInteractive \
    -File C:\\install-ace.ps1 && \
    del C:\\install-ace.ps1

WORKDIR C:\\mdbapi
